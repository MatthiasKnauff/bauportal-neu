{
  "name": "bauportal-neu",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/start.ts",
    "dev:ui": "vite",
    "typen": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:klick": "node tests/ui/klick.mjs",
    "build": "vite build && esbuild src/server/start.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" && node tools/aufbau.mjs dist/aufbau.json",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "lucide": "^1.80.0",
    "nodemailer": "^10.6.1",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.23.1",
    "solid-js": "^1.9.20"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.17"
  }
}
